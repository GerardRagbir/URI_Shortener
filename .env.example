# Copy to .env and adjust. Every value shown is the default.

# sqlite:///./urls.db | postgresql://user:pass@host/db | mysql://user:pass@host/db | memory://
DATABASE_URL=sqlite:///./urls.db

# Public origin printed in short links and QR codes. Defaults to the request's origin.
# BASE_URL=https://u.example.com

HOST=127.0.0.1
PORT=8000

# Signs the session cookie. Set a long random value outside local development.
STORAGE_SECRET=dev-only-change-me

# Set to true behind a reverse proxy so the visitor's IP is read from X-Forwarded-For.
TRUST_PROXY_HEADERS=false

ALLOW_ANONYMOUS=true

# Default accounts, created on first start. Change the passwords before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
SEED_DEMO_DATA=true

# Abuse protection, counted per client IP address.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300        # pages and API calls per minute
RATE_LIMIT_REDIRECTS=60        # short links followed per minute
RATE_LIMIT_LINKS=20            # links created per minute
RATE_LIMIT_LINKS_DAILY=300     # links created per day
RATE_LIMIT_LOGINS=10           # failed sign-ins per 10 minutes
# Exceeding a limit this many times within an hour blocks the address (0 disables).
AUTO_BLOCK_STRIKES=5
AUTO_BLOCK_HOURS=24

GEOIP_ENABLED=true
GEOIP_TIMEOUT=4.0
# Resolve private addresses (localhost) to this machine's public location; useful in development.
GEOIP_LOCAL_FALLBACK=false
